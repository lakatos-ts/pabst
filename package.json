{
  "name": "@lakatos/pabst",
  "version": "0.1.1",
  "description": "Refutation for TypeScript: @ensures annotations become fast-check property tests, run with vitest and reported in the lakatos result envelope.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pabst": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "schemas"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakatos-ts/pabst.git"
  },
  "homepage": "https://github.com/lakatos-ts/pabst#readme",
  "bugs": {
    "url": "https://github.com/lakatos-ts/pabst/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@lakatos/lemma": "^0.2.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "fast-check": "^4.8.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "prettier": "3.9.9",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
